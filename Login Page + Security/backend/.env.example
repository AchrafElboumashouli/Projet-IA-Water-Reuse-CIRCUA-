# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_app_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Registration security
# If true (default), self-registering as 'admin' creates a PENDING account
# that must be approved (see ADMIN_APPROVAL_EMAIL below) before it can log in.
# If false, any non-user/guest role request is silently downgraded to
# DEFAULT_PUBLIC_ROLE instead — use this only for local demo/testing.
ENFORCE_SAFE_PUBLIC_ROLES=true
DEFAULT_PUBLIC_ROLE=user

# Admin approval workflow
# Inbox that receives "New Admin Registration Request" notifications.
# Required for the admin self-registration flow to notify anyone; if unset,
# registration still succeeds but a warning is logged and no email is sent.
ADMIN_APPROVAL_EMAIL=admin-approvals@example.com
# Shown to users if their approval is taking a while.
SUPPORT_EMAIL=admin@example.com

# Frontend URL (used to build password reset links)
FRONTEND_URL=http://localhost:3000

# Backend URL (used to build the one-click Approve/Reject links embedded in
# the admin-approval-request email; must be reachable by whoever opens the
# email, so use a public URL in production, e.g. https://api.yourdomain.com)
BACKEND_URL=http://localhost:5000

# SMTP (Nodemailer) - used to send password reset emails
# Never commit real credentials; fill these in your local .env file only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Smart Water Quality Monitoring <no-reply@smartwaterquality.com>"

# Optional: route SMTP through a proxy (e.g. if your network/OS proxy
# intercepts and resets direct SMTP connections). Leave commented out/empty
# for a direct connection — this is the default and works for most networks.
# Examples:
#   SMTP_PROXY=http://127.0.0.1:8080          (HTTP CONNECT proxy)
#   SMTP_PROXY=socks5://127.0.0.1:1080         (SOCKS5 proxy, needs `npm install socks`)
#SMTP_PROXY=
