# ==========================================================
# Configuration du service MONITORING (Tâche 2)
# ==========================================================

APP_NAME=Water Quality Monitoring - Service Monitoring
LOG_LEVEL=INFO
PORT=8001

# URL de l'API de l'équipe stockage (backend_equipe_stockage), SEULE
# source de données. Ne jamais mettre une DATABASE_URL ici : ce service
# ne se connecte jamais directement à PostgreSQL.
STORAGE_API_BASE_URL=http://localhost:8000
STORAGE_API_TIMEOUT_SECONDS=20

# Rafraîchissement quasi temps-réel (secondes)
POLL_INTERVAL_SECONDS=15

# Détection d'anomalies
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.05
AUTOENCODER_ERROR_PERCENTILE=97.5
ANOMALY_MIN_POINTS=30
