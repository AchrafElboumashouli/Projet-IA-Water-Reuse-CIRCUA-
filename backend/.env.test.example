# ==========================================================
# Configuration de l'application - Water Quality Monitoring
# ==========================================================

# --- Base de données PostgreSQL ---
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:?@localhost:5432/water_quality_db

# --- Application ---
APP_NAME=Water Quality Monitoring API
LOG_LEVEL=INFO

# --- Sensor sets (ThingSpeak channels) ---
# Fully configurable list of sensor sets, as a JSON array. Add, remove, or
# reconfigure a set by editing this single value -- no code changes needed.
# Each entry: {"set_number": <int>, "channel_id": "<thingspeak channel id>",
#              "api_key": "<read api key, or null if the channel is public>"}
SENSOR_SETS=[{"set_number": 1, "channel_id": "3111290", "api_key": null}, {"set_number": 2, "channel_id": "3243723", "api_key": null}]

# --- Collector (APScheduler) ---
# Intervalle (en minutes) entre deux collectes ThingSpeak
COLLECTOR_INTERVAL_MINUTES=5

# Nombre de résultats récupérés à chaque appel ThingSpeak (max 8000)
THINGSPEAK_RESULTS_COUNT=10

# --- Fuseau horaire ---
# Fuseau horaire "métier" unique de l'application (formulaires, import
# Excel, logs, scheduler, affichage). Toutes les données sont stockées en
# base en UTC ; changer cette seule valeur suffit à changer le fuseau
# horaire de toute l'application. Doit être un nom de zone IANA valide.
TIMEZONE=Africa/Casablanca

# --- Alert notifications: SMTP email ---
# All optional. If any of SMTP_HOST / SMTP_PORT / SMTP_FROM_EMAIL /
# ALERT_EMAIL_RECIPIENTS is left empty, email notifications are silently
# disabled (no error, just skipped). SMTP_USERNAME/SMTP_PASSWORD are only
# used if both are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Comma-separated list of recipient emails, e.g. ops@example.com,alerts@example.com
ALERT_EMAIL_RECIPIENTS=

# --- Alert notifications: Telegram ---
# Both must be set for Telegram notifications to fire; otherwise silently
# disabled. Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN, then
# message the bot (or add it to a group/channel) and use
# https://api.telegram.org/bot<token>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
